#!/usr/bin/env bash
# Report job status without blocking. Reconciles stale 'running' against PID liveness.
# Usage:
#   bgstatus            # list all jobs (one line each)
#   bgstatus <job-id>   # detailed status for one job
#   bgstatus --json     # JSON array of all jobs
#   bgstatus --json <job-id>  # JSON array for one job
#
# BGRUN_DIR env var: overrides the default job directory (~/.bgrun/jobs).
set -u
RUN_DIR="${BGRUN_DIR:-$HOME/.bgrun/jobs}"

# Parse --json flag
_json=false
_job_arg=""
for arg in "$@"; do
  case "$arg" in
    --json) _json=true ;;
    *)      _job_arg="$arg" ;;
  esac
done

[ -d "$RUN_DIR" ] || { if [ "$_json" = true ]; then echo "[]"; else echo "no jobs"; fi; exit 0; }

reconcile() { # $1=status-file -> prints effective state
  local f="$1" state pid
  state="$(sed -n 's/^state=//p' "$f")"
  if [ "$state" = "running" ]; then
    pid="$(sed -n 's/^pid=//p' "$f")"
    if [ -z "$pid" ]; then
      # Empty pid = startup window (bgrun hasn't written it yet) OR bgrun died before
      # recording it. Use started= to distinguish: if more than 5 seconds have passed
      # with no pid, bgrun is gone and the runner was never detached.
      local started now
      started="$(sed -n 's/^started=//p' "$f")"
      now="$(date +%s)"
      if [ -n "$started" ] && [ $(( now - started )) -gt 5 ]; then
        echo "crashed"
      else
        echo "running"
      fi
    elif kill -0 "$pid" 2>/dev/null; then echo "running"
    else echo "crashed"; fi
  else
    echo "$state"
  fi
}

# Build a JSON object from a .status file. Outputs one line of JSON.
status_to_json() {
  local f="$1"
  local id state exit_code cmd pid start end cwd name log_path
  id="$(basename "$f" .status)"
  state="$(reconcile "$f")"
  exit_code="$(sed -n 's/^exit=//p' "$f")"
  cmd="$(sed -n 's/^cmd=//p' "$f")"
  pid="$(sed -n 's/^pid=//p' "$f")"
  start="$(sed -n 's/^started=//p' "$f")"
  end="$(sed -n 's/^finished=//p' "$f")"
  cwd="$(sed -n 's/^cwd=//p' "$f")"
  name="$(sed -n 's/^name=//p' "$f")"
  log_path="$(dirname "$f")/$id.log"
  # Escape double-quotes in string values for valid JSON
  cmd="$(printf '%s' "$cmd" | sed 's/\\/\\\\/g; s/"/\\"/g')"
  cwd="$(printf '%s' "$cwd" | sed 's/\\/\\\\/g; s/"/\\"/g')"
  name="$(printf '%s' "$name" | sed 's/\\/\\\\/g; s/"/\\"/g')"
  log_path="$(printf '%s' "$log_path" | sed 's/\\/\\\\/g; s/"/\\"/g')"
  # Build JSON object
  printf '{"id":"%s","state":"%s"' "$id" "$state"
  [ -n "$cmd" ]       && printf ',"cmd":"%s"' "$cmd"
  [ -n "$pid" ]       && printf ',"pid":"%s"' "$pid"
  [ -n "$start" ]     && printf ',"start":"%s"' "$start"
  [ -n "$end" ]       && printf ',"end":"%s"' "$end"
  [ -n "$exit_code" ] && printf ',"exit":"%s"' "$exit_code"
  [ -n "$cwd" ]       && printf ',"cwd":"%s"' "$cwd"
  [ -n "$name" ]      && printf ',"name":"%s"' "$name"
  printf ',"log_path":"%s"}' "$log_path"
}

if [ -n "$_job_arg" ]; then
  f="$RUN_DIR/$_job_arg.status"
  [ -f "$f" ] || { echo "unknown job: $_job_arg" >&2; exit 1; }
  if [ "$_json" = true ]; then
    printf '['; status_to_json "$f"; printf ']\n'
    exit 0
  fi
  eff="$(reconcile "$f")"
  echo "job:   $_job_arg"
  echo "state: $eff"
  sed -n 's/^exit=/exit:  /p; s/^cmd=/cmd:   /p; s/^name=/name:  /p' "$f"
  # Elapsed / duration
  started="$(sed -n 's/^started=//p' "$f")"
  finished="$(sed -n 's/^finished=//p' "$f")"
  now="$(date +%s)"
  if [ -n "$started" ]; then
    end="${finished:-$now}"
    secs=$(( end - started ))
    if [ "$secs" -ge 3600 ]; then
      elapsed="$(( secs/3600 ))h $(( (secs%3600)/60 ))m $(( secs%60 ))s"
    elif [ "$secs" -ge 60 ]; then
      elapsed="$(( secs/60 ))m $(( secs%60 ))s"
    else
      elapsed="${secs}s"
    fi
    echo "elapsed: $elapsed"
  fi
  [ "$eff" = "crashed" ] && echo "note:  process died without recording exit code — inspect the log"
  exit 0
fi

# JSON list mode
if [ "$_json" = true ]; then
  first=true
  printf '['
  for f in "$RUN_DIR"/*.status; do
    [ -f "$f" ] || continue
    [ "$first" = true ] || printf ','
    first=false
    status_to_json "$f"
  done
  printf ']\n'
  exit 0
fi

# list mode
found=0
for f in "$RUN_DIR"/*.status; do
  [ -f "$f" ] || continue
  found=1
  id="$(basename "$f" .status)"
  name="$(sed -n 's/^name=//p' "$f")"
  if [ -n "$name" ]; then
    printf '%-40s %-20s %s\n' "$id" "[$name]" "$(reconcile "$f")"
  else
    printf '%-40s %s\n' "$id" "$(reconcile "$f")"
  fi
done
[ "$found" -eq 0 ] && echo "no jobs"
