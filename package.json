{
  "name": "@stablekernel/opencode-bgrun",
  "version": "0.1.3",
  "description": "Background job runner for AI coding agents with live session wake-to-act on OpenCode.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./plugin/bgrun-wake.js",
  "exports": {
    ".": "./plugin/bgrun-wake.js"
  },
  "bin": {
    "bgrun": "./bin/bgrun",
    "bgstatus": "./bin/bgstatus",
    "bgtail": "./bin/bgtail",
    "bgclean": "./bin/bgclean",
    "bgwait": "./bin/bgwait",
    "bgkill": "./bin/bgkill"
  },
  "scripts": {
    "test": "node plugin/bgrun-wake.test.js",
    "lint": "shellcheck bin/bgrun bin/bgstatus bin/bgtail bin/bgclean bin/_bgrunner.sh bin/bgwait bin/bgkill install.sh uninstall.sh && node --check plugin/bgrun-wake.js"
  },
  "files": [
    "bin/",
    "plugin/bgrun-wake.js",
    "skill/",
    "install.sh",
    "uninstall.sh",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/stablekernel/opencode-bgrun.git"
  },
  "homepage": "https://github.com/stablekernel/opencode-bgrun#readme",
  "bugs": {
    "url": "https://github.com/stablekernel/opencode-bgrun/issues"
  },
  "keywords": [
    "opencode",
    "plugin",
    "background",
    "bgrun",
    "ai",
    "agent"
  ],
  "author": "stablekernel",
  "dependencies": {
    "@opencode-ai/plugin": "^1.16.2",
    "zod": "^4.1.8"
  }
}
